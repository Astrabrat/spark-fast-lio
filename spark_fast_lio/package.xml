<?xml version="1.0"?>
<package format="3">
  <name>spark_fast_lio</name>
  <version>0.0.0</version>

  <description>
    This is a modified version of Fast-LIO2 for MIT SPARK
  </description>

  <maintainer email="shapelim@mit.edu">Hyungtae Lim</maintainer>

  <license>GPL</license>

  <depend>rcutils</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>

  <!-- KISS-Matcher enables global relocalization with no operator initial pose.
       Without it the package still builds, but relocalization.global.enabled is
       forced off at startup and an /initialpose is required instead.

       This dependency is what makes find_package(kiss_matcher) succeed in a
       colcon build: KISS-Matcher's ros/ directory is the ament package
       kiss_matcher_ros, it add_subdirectory()s cpp/kiss_matcher, and so building
       it first installs the kiss_matcher CMake config into the overlay that
       colcon then puts on our CMAKE_PREFIX_PATH. It also pulls in gtsam and
       fetches small_gicp.

       Drop this line only if you install cpp/kiss_matcher standalone into a
       prefix that is already on CMAKE_PREFIX_PATH. Do not "comment it out" with
       the build commands spelled inline: a double dash cannot appear inside an
       XML comment, which is what made this manifest unparseable to colcon.
  -->
  <depend>kiss_matcher_ros</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>ros2bag</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
